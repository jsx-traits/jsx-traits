{
  "name": "jsx-traits",
  "description": "Monorepo for @jsx-traits/* packages",
  "version": "0.2.0-next.1",
  "homepage": "https://jsx-traits.com",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "scripts/*",
    "site"
  ],
  "scripts": {
    "docs": "wireit",
    "prepare": "husky"
  },
  "wireit": {
    "docs": {
      "command": "api-documenter markdown -i temp -o docs/api",
      "dependencies": [
        "./packages/react:apix"
      ]
    }
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.56.0",
    "@types/node": "^24.0.0",
    "commitlint": "^21.0.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.1",
    "wireit": "^0.14.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsx-traits/jsx-traits.git"
  }
}
